{#
/**
 * @file
 * Theme override for the page display of the "Browse" view.
 *
 * Lists the whole media library as tiles. The filters are facet blocks in the
 * sidebar region, which the browse layout moves to the left of the results.
 *
 * The page title block is hidden on this path: the heading belongs with the
 * result count, so it is printed here instead. A page display hands its title
 * to that block rather than to the "title" variable, so it is read off the
 * view when the variable is empty.
 *
 * Named after the display on purpose, so the suggestion stays specific to this
 * view and display.
 *
 * @see views-view.html.twig
 * @see \Drupal\elaintehtaat_theme\Hook\ElaintehtaatThemeHooks::preprocessPage()
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'browse',
  ]
%}
{{ attach_library('elaintehtaat_theme/browse') }}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <header class="browse__head">
    <p class="eyebrow browse__eyebrow">{{ 'Browse the archive'|t }}</p>
    <div class="browse__headline">
      <h1 class="browse__title">{{ title ?: view.getTitle() }}</h1>
      {% if view.total_rows is not null %}
        {# The plural variable has to be called "count": the .po entry keys on @count. #}
        {% set count = view.total_rows %}
        <p class="browse__count muted">
          {% trans %}{{ count }} media item{% plural count %}{{ count }} media{% endtrans %}
        </p>
      {% endif %}
    </div>
  </header>

  {% if rows %}
    <div class="view-content browse__grid">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-empty browse__empty">
      {{ empty }}
    </div>
  {% endif %}

  {% if pager %}
    {{ pager }}
  {% endif %}
</div>
