{#
/**
 * @file
 * Theme override for the "Related albums" view.
 *
 * Shows the other albums of the project the current album belongs to, with a
 * section header naming the project and a link to the project page.
 *
 * Additional variables (set in ElaintehtaatThemeHooks::preprocessViewsViewRelatedAlbums()):
 * - project: The project node of the album being viewed, in the current
 *   language, or NULL when the view is rendered outside an album page.
 *
 * @see views-view.html.twig
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'related-albums',
  ]
%}
{{ attach_library('elaintehtaat_theme/related-albums') }}
<section{{ attributes.addClass(classes) }} aria-labelledby="related-albums-heading">
  {{ title_prefix }}
  {{ title_suffix }}

  <header class="related-albums__head">
    <div>
      <p class="eyebrow related-albums__eyebrow">{{ 'More from this project'|t }}</p>
      <h2 id="related-albums-heading" class="related-albums__title">
        {{ project ? project.label : 'Albums'|t }}
      </h2>
    </div>
    {% if project %}
      <a class="related-albums__link" href="{{ path('entity.node.canonical', {'node': project.id}) }}">
        {{ 'Whole project'|t }}<span aria-hidden="true"> →</span>
      </a>
    {% endif %}
  </header>

  {% if rows %}
    <div class="view-content">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-empty">
      {{ empty }}
    </div>
  {% endif %}
</section>
