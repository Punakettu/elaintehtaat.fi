{#
/**
 * @file
 * Theme override for the page display of the "Projects" view.
 *
 * Lists every project as a card grid under the page heading. The page title
 * block is hidden on this path, so the heading is printed here, with an
 * eyebrow above it.
 *
 * Named after the display on purpose: the view is tagged "Frontpage", which
 * gives it the plain views-view--frontpage suggestion too, and the block
 * display has a listing of its own.
 *
 * @see views-view.html.twig
 * @see templates/views/views-view--projects--block-1.html.twig
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'projects-page',
  ]
%}
{{ attach_library('elaintehtaat_theme/project-card') }}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <header class="projects-page__head">
    <p class="eyebrow projects-page__eyebrow">{{ 'Projects'|t }}</p>
    {# A page display hands its title to the page title block, not to the
       "title" variable, so it is read off the view when that is empty. #}
    <h1 class="projects-page__title">{{ title ?: view.getTitle() }}</h1>
  </header>

  {% if rows %}
    <div class="view-content projects-page__grid">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-empty projects-page__empty">
      {{ empty }}
    </div>
  {% endif %}

  {% if pager %}
    {{ pager }}
  {% endif %}
</div>
