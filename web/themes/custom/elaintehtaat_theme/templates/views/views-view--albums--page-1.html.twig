{#
/**
 * @file
 * Theme override for the page display of the "Albums" view.
 *
 * Lists every album, of every project, as a card grid under the page heading,
 * newest first. The page title block is hidden on this path, so the heading is
 * printed here, with an eyebrow above it and the album count beside it.
 *
 * Named after the display on purpose: the view is tagged "Frontpage", which
 * gives it the plain views-view--frontpage suggestion too, and the block
 * display on the front page has a listing of its own.
 *
 * @see views-view.html.twig
 * @see templates/content/node--album--teaser.html.twig
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'albums-page',
  ]
%}
{{ attach_library('elaintehtaat_theme/album-card') }}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <header class="albums-page__head">
    <p class="eyebrow albums-page__eyebrow">{{ 'Albums'|t }}</p>
    <div class="albums-page__headline">
      {# A page display hands its title to the page title block, not to the
         "title" variable, so it is read off the view when that is empty. #}
      <h1 class="albums-page__title">{{ title ?: view.getTitle() }}</h1>
      {% if view.total_rows is not null %}
        {# The plural variable has to be called "count": the .po entry keys on @count. #}
        {% set count = view.total_rows %}
        <p class="albums-page__count muted">
          {% trans %}{{ count }} album{% plural count %}{{ count }} albums{% endtrans %}
        </p>
      {% endif %}
    </div>
  </header>

  {% if rows %}
    <div class="view-content albums-page__grid">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-empty albums-page__empty">
      {{ empty }}
    </div>
  {% endif %}

  {% if pager %}
    {{ pager }}
  {% endif %}
</div>
