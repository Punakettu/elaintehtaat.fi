{#
/**
 * @file
 * Theme override for the block display of the "Projects" view.
 *
 * Lists the promoted projects as an index of rows under a section header that
 * names how many there are.
 *
 * Named after the display on purpose: the view is tagged "Frontpage", which
 * gives it the plain views-view--frontpage suggestion too.
 *
 * @see views-view.html.twig
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'projects',
  ]
%}
{{ attach_library('elaintehtaat_theme/projects') }}
<section{{ attributes.addClass(classes) }} aria-labelledby="projects-heading">
  {{ title_prefix }}
  {{ title_suffix }}

  <header class="projects__head">
    <h2 id="projects-heading" class="projects__title">{{ 'Projects'|t }}</h2>
    {# The pager shows every promoted project, so the rows are the whole set. #}
    <span class="projects__count faint">{{ view.result|length }}</span>
  </header>

  {% if rows %}
    <div class="view-content projects__list">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-empty">
      {{ empty }}
    </div>
  {% endif %}
</section>
