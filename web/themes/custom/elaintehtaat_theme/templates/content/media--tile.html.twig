{#
/**
 * @file
 * Theme override for a media item rendered in the tile view mode.
 *
 * Renders the item as an image tile for gallery listings: the thumbnail fills
 * the tile, and the caption and the name of the album the item belongs to are
 * revealed over the image on hover and focus. The album link is stretched over
 * the whole tile.
 *
 * Additional content:
 * - content.album: Link to the album containing the item, when it belongs to
 *   a published album (added by \Drupal\elaintehtaat\Hook\MediaTileHooks).
 *
 * @see media.html.twig
 */
#}
{%
  set classes = [
    'media',
    'media--type-' ~ media.bundle()|clean_class,
    not media.isPublished() ? 'media--unpublished',
    'media--view-mode-tile',
    'media-tile',
  ]
%}
{% set has_caption = content.field_caption|render|trim is not empty %}
{{ attach_library('elaintehtaat_theme/media-tile') }}
<article{{ attributes.addClass(classes) }}>
  {{ title_suffix.contextual_links }}
  <div class="media-tile__image">
    {{ content.thumbnail }}
  </div>
  {% if has_caption or content.album %}
    <div class="media-tile__meta">
      {% if has_caption %}
        <div class="media-tile__caption">{{ content.field_caption }}</div>
      {% endif %}
      {% if content.album %}
        <div class="media-tile__album">{{ content.album }}</div>
      {% endif %}
    </div>
  {% endif %}
  {{ content|without('thumbnail', 'field_caption', 'album') }}
</article>
