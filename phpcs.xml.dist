<?xml version="1.0" encoding="UTF-8"?>
<!-- PHP_CodeSniffer configuration for custom code. Copy to phpcs.xml for local
     overrides (ignored by git). Standards come from drupal/coder. -->
<ruleset name="elaintehtaat">
  <description>Drupal and DrupalPractice coding standards.</description>

  <file>web/modules/custom</file>
  <file>web/themes/custom</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,css,info,txt,md,yml"/>
  <arg name="colors"/>
  <arg name="cache" value=".phpcs-cache"/>
  <arg name="parallel" value="8"/>
  <arg value="p"/>

  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/tests/fixtures/*</exclude-pattern>
  <exclude-pattern>*\.min\.(js|css)$</exclude-pattern>
  <!-- Compiled theme assets. -->
  <exclude-pattern>*/dist/*</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
