# Copy to .env and adjust. Docker Compose reads this file automatically.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=drupal
MYSQL_USER=drupal
MYSQL_PASSWORD=drupal

# Generate with: openssl rand -hex 32
DRUPAL_HASH_SALT=change-me

# Public URL of the site; used by drush for generated links (e.g. drush uli).
DRUPAL_BASE_URL=http://localhost:8080

# S3-compatible storage (RustFS). S3_PUBLIC_HOST is what the browser uses.
S3_BUCKET=drupal-files
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_PUBLIC_HOST=localhost:9000

# --- Bunny Stream API keys for the "Video library"  ---------------------------
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READ_ONLY_API_KEY=
# Optional. Setting it makes the library private: enable "Embed View Token
# Authentication" under Stream > Security first.
# BUNNY_STREAM_TOKEN_AUTHENTICATION_KEY=

# --- Optional ngrok tunnel (`make ngrok`) -------------------------------------
# Exposes the local site on a public URL. Only used with the `ngrok` profile.

# ngrok auth token (https://dashboard.ngrok.com/get-started/your-authtoken).
# NGROK_AUTHTOKEN=

# Ngrok domain to bind the tunnel to, e.g. your-name.ngrok-free.app.
# NGROK_DOMAIN=your-name.ngrok-free.app

# Host port for the ngrok web inspector UI. Defaults to 4040.
# PORT_NGROK_WEB=4040

# --- Optional Xdebug -----------------------------------------------------------
# Enables debugging (xdebug.mode=debug).
# XDEBUG_ENABLE=true
