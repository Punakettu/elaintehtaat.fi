# Copy to .env and adjust. Docker Compose reads this file automatically.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=drupal
MYSQL_USER=drupal
MYSQL_PASSWORD=drupal

# Generate with: openssl rand -hex 32
DRUPAL_HASH_SALT=change-me

# Public URL of the site; used by drush for generated links (e.g. drush uli).
DRUPAL_BASE_URL=http://localhost:8080

# S3-compatible storage (RustFS). S3_PUBLIC_HOST is what the browser uses.
S3_BUCKET=drupal-files
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_PUBLIC_HOST=localhost:9000
